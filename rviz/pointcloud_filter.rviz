Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 80; 80; 80
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Input point cloud (gray)
      Enabled: true
      Topic:
        Value: /merged_pointcloud
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 170; 170; 170
      Alpha: 0.3
      Style: Flat Squares
      Size (Pixels): 2
      Size (m): 0.05
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered point cloud (green)
      Enabled: true
      Topic:
        Value: /merged_pointcloud_filtered
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 38; 242; 89
      Alpha: 1
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.07
      Decay Time: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 180
      Focal Point:
        X: 25
        Y: 40
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1400
  Height: 900
